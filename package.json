{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "admin:manage": "node scripts/manage-storefront-admin.mjs",
    "images:import": "node scripts/import-product-images.mjs",
    "images:pending": "node scripts/export-pending-product-images.mjs",
    "images:import-sku": "node scripts/import-sku-named-product-images.mjs",
    "images:normalize": "node scripts/catalog-images/catalog-images.mjs",
    "images:normalize:inventory": "node scripts/catalog-images/catalog-images.mjs --dry-run",
    "images:normalize:pilot": "node scripts/catalog-images/catalog-images.mjs --pilot",
    "images:unify": "node scripts/catalog-images/unify-storefront.mjs",
    "images:unify:check": "node scripts/catalog-images/unify-storefront.mjs --check",
    "images:edge-upload": "node scripts/catalog-images/edge-upload.mjs",
    "images:normalize:sql": "node scripts/catalog-images/sql-publication.mjs",
    "test:image-normalization": "node --test scripts/catalog-images/edge-upload.test.mjs scripts/catalog-images/inventory.test.mjs scripts/catalog-images/report.test.mjs scripts/catalog-images/sql-publication.test.mjs scripts/catalog-images/storage.test.mjs scripts/catalog-images/unify-storefront.test.mjs supabase/functions/catalog-image-upload-temporary/handler.test.mjs && .codex-tmp\\catalog-images-venv\\Scripts\\python.exe -m unittest discover -s scripts/catalog-images/python -p \"test_*.py\" -v",
    "test:catalog-edge-function": "node --test supabase/functions/catalog-image-upload-temporary/handler.test.mjs",
    "test:image-import": "node --test scripts/product-image-import.test.mjs",
    "test:repair-portal": "node --test scripts/repair-portal-contract.test.mjs",
    "test:storefront-ui": "node --test scripts/storefront-ui-contract.test.mjs",
    "test:railway-keys": "node --test scripts/railway/with-supabase-keys.test.mjs",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts && npm run test:railway-keys && npm run test:storefront-ui",
    "css:prune": "node scripts/prune-legacy-css.mjs --write"
  },
  "dependencies": {
    "@react-email/render": "2.3.1",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "gsap": "3.15.1",
    "lucide-react": "0.511.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tesseract.js": "7.0.0",
    "unzipper": "0.12.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.10",
    "prettier": "3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
